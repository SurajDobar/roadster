---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact | 3D Tesla Roadster Game" 
  description="Contact the developer of the 3D Tesla Roadster Game. Send feedback, bug reports, or inquiries directly to surajdobardev@gmail.com."
  canonical="https://roadster-play.vercel.app/contact"
  keywords="Contact Tesla Roadster Game, Suraj Dobar, Roadster simulator feedback, bug report WebGL"
>
  <!-- Schema.org Structured Data: ContactPage -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact the 3D Tesla Roadster Game Developer",
    "url": "https://roadster-play.vercel.app/contact",
    "description": "Direct communication channel for bug reports, game feedback, and developer inquiries.",
    "mainEntity": {
      "@type": "Organization",
      "name": "3D Tesla Roadster Game Project",
      "url": "https://roadster-play.vercel.app/",
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "surajdobardev@gmail.com",
        "contactType": "developer support",
        "availableLanguage": ["English"]
      }
    },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://roadster-play.vercel.app/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Contact",
          "item": "https://roadster-play.vercel.app/contact"
        }
      ]
    }
  }
  </script>

  <div style="max-width: 800px; margin: 0 auto; padding: 3rem 1.5rem 6rem;">
    
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" style="margin-bottom: 2rem;">
      <ol style="list-style: none; display: flex; align-items: center; gap: 0.5rem; font-size: 13px; color: var(--mute); padding: 0; margin: 0; font-family: 'Geist Mono', monospace;">
        <li><a href="/" class="nav-link" style="padding: 0;">Home</a></li>
        <li aria-hidden="true" style="color: var(--faint);">/</li>
        <li aria-current="page" style="color: var(--ink); font-weight: 600;">Contact</li>
      </ol>
    </nav>

    <!-- Page Header -->
    <header style="margin-bottom: 2.5rem;">
      <span class="mono-eyebrow" style="color: var(--link);">GET IN TOUCH</span>
      <h1 class="display-xl" style="margin-top: 0.5rem; color: var(--ink);">
        Contact
      </h1>
      <p class="body-lg" style="margin-top: 1rem; color: var(--body);">
        Have feedback, suggestions, physics questions, or a bug to report? Reach out directly via email.
      </p>
    </header>

    <!-- Clean, Focused Contact Card -->
    <div class="vercel-card" style="padding: 2.5rem 2rem; display: flex; flex-direction: column; gap: 1.5rem;">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 10px; background: var(--link-soft-bg); color: var(--link); flex-shrink: 0;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
        </div>
        <div>
          <span class="mono-eyebrow" style="color: var(--mute); display: block;">DIRECT EMAIL</span>
          <a 
            href="mailto:surajdobardev@gmail.com" 
            style="color: var(--ink); font-size: clamp(1.1rem, 3vw, 1.4rem); font-weight: 600; text-decoration: none; word-break: break-all; transition: color 0.15s ease;"
            onmouseover="this.style.color='var(--link)'"
            onmouseout="this.style.color='var(--ink)'"
          >
            surajdobardev@gmail.com
          </a>
        </div>
      </div>

      <div style="border-top: 1px solid var(--hairline); padding-top: 1.5rem; display: flex; gap: 1rem; flex-wrap: wrap;">
        <a 
          href="mailto:surajdobardev@gmail.com" 
          class="btn-pill-primary" 
          style="height: 42px; padding: 0 20px; font-size: 14px;"
        >
          <span>Send Email</span>
          <span aria-hidden="true">↗</span>
        </a>
        <button 
          id="copy-email-btn" 
          class="btn-pill-secondary" 
          style="height: 42px; padding: 0 18px; font-size: 14px;"
          type="button"
        >
          <span id="copy-btn-text">Copy Email Address</span>
        </button>
      </div>

      <div style="background: var(--canvas-sunken); border: 1px solid var(--hairline-soft); border-radius: 8px; padding: 1rem 1.25rem; font-size: 13px; color: var(--mute); line-height: 1.6; display: flex; flex-direction: column; gap: 0.35rem;">
        <div><strong style="color: var(--ink);">Developer:</strong> Suraj Dobar</div>
        <div><strong style="color: var(--ink);">Project:</strong> 3D Tesla Roadster Game &amp; WebGL Simulator</div>
        <div><strong style="color: var(--ink);">Response Time:</strong> Messages are typically answered within 24–48 hours.</div>
      </div>
    </div>

    <!-- Quick Back to Game Banner -->
    <div style="margin-top: 3rem; text-align: center;">
      <a href="/play" class="btn-pill-primary" style="height: 42px; padding: 0 22px;">
        <span>Launch Roadster Simulator</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>

  </div>

  <script>
    const copyBtn = document.getElementById('copy-email-btn');
    const copyText = document.getElementById('copy-btn-text');

    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('surajdobardev@gmail.com');
          copyText.textContent = 'Copied to Clipboard! ✓';
          copyBtn.style.borderColor = 'var(--link)';
          setTimeout(() => {
            copyText.textContent = 'Copy Email Address';
            copyBtn.style.borderColor = '';
          }, 2500);
        } catch (err) {
          copyText.textContent = 'surajdobardev@gmail.com';
        }
      });
    }
  </script>
</Layout>
