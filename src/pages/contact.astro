---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact Us | 3D Tesla Roadster Game Support & Feedback" 
  description="Contact the 3D Tesla Roadster Game engineering team. Submit WebGL bug reports, suggest hypercar features, give physics feedback, or make press inquiries."
  canonical="https://roadster-play.vercel.app/contact"
  keywords="Contact Tesla Roadster Game, Roadster simulator feedback, bug report WebGL, feature request hypercar game, Tesla Roadster support, WebGL car simulator inquiry"
>
  <!-- Schema.org Structured Data: ContactPage -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact the 3D Tesla Roadster Game Team",
    "url": "https://roadster-play.vercel.app/contact",
    "description": "Direct communication channel for bug reports, game feedback, physics suggestions, and developer inquiries.",
    "mainEntity": {
      "@type": "Organization",
      "name": "3D Tesla Roadster Game Project",
      "url": "https://roadster-play.vercel.app/",
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "support@roadster-play.vercel.app",
        "contactType": "customer support",
        "availableLanguage": ["English"]
      }
    },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://roadster-play.vercel.app/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Contact Us",
          "item": "https://roadster-play.vercel.app/contact"
        }
      ]
    }
  }
  </script>

  <div style="max-width: 1180px; margin: 0 auto; padding: 2.5rem 1.5rem 5rem;">
    
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" style="margin-bottom: 2.5rem;">
      <ol style="list-style: none; display: flex; align-items: center; gap: 0.5rem; font-size: 13px; color: var(--mute); padding: 0; margin: 0; font-family: 'Geist Mono', monospace;">
        <li><a href="/" class="nav-link" style="padding: 0;">Home</a></li>
        <li aria-hidden="true" style="color: var(--faint);">/</li>
        <li aria-current="page" style="color: var(--ink); font-weight: 600;">Contact Us</li>
      </ol>
    </nav>

    <!-- Page Header / Hero -->
    <header style="max-width: 820px; margin-bottom: 3.5rem;">
      <span class="mono-eyebrow" style="color: var(--link);">GET IN TOUCH</span>
      <h1 class="display-xl" style="margin-top: 0.5rem; color: var(--ink);">
        We’d Love to Hear From You
      </h1>
      <p class="body-lg" style="margin-top: 1.25rem; color: var(--body); line-height: 1.7;">
        Have a bug to report, a telemetry benchmark to share, or an idea for the next gameplay circuit? Reach out using the form below or connect with our team directly. We review every message.
      </p>
    </header>

    <!-- Main Content: Form + Information Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; align-items: start;">
      
      <!-- Interactive Contact Form -->
      <div class="vercel-card" style="padding: 2.25rem;">
        <span class="mono-eyebrow" style="color: var(--mute);">TRANSMIT MESSAGE</span>
        <h2 class="heading-md" style="margin-top: 0.5rem; color: var(--ink); margin-bottom: 1.5rem;">Send an Inquiry</h2>

        <form id="contact-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
          
          <!-- Full Name -->
          <div>
            <label for="contact-name" style="display: block; font-size: 13px; font-weight: 600; color: var(--ink); margin-bottom: 0.4rem; font-family: 'Geist Mono', monospace;">
              YOUR NAME <span style="color: var(--link);">*</span>
            </label>
            <input 
              type="text" 
              id="contact-name" 
              name="name" 
              required 
              placeholder="e.g. Alex Vance"
              style="width: 100%; height: 42px; padding: 0 12px; background: var(--canvas-sunken); border: 1px solid var(--hairline); border-radius: 6px; color: var(--ink); font-size: 14px; font-family: inherit; transition: border-color 0.15s ease;"
            />
          </div>

          <!-- Email Address -->
          <div>
            <label for="contact-email" style="display: block; font-size: 13px; font-weight: 600; color: var(--ink); margin-bottom: 0.4rem; font-family: 'Geist Mono', monospace;">
              EMAIL ADDRESS <span style="color: var(--link);">*</span>
            </label>
            <input 
              type="email" 
              id="contact-email" 
              name="email" 
              required 
              placeholder="alex@example.com"
              style="width: 100%; height: 42px; padding: 0 12px; background: var(--canvas-sunken); border: 1px solid var(--hairline); border-radius: 6px; color: var(--ink); font-size: 14px; font-family: inherit; transition: border-color 0.15s ease;"
            />
          </div>

          <!-- Inquiry Category -->
          <div>
            <label for="contact-category" style="display: block; font-size: 13px; font-weight: 600; color: var(--ink); margin-bottom: 0.4rem; font-family: 'Geist Mono', monospace;">
              INQUIRY CATEGORY <span style="color: var(--link);">*</span>
            </label>
            <select 
              id="contact-category" 
              name="category" 
              required
              style="width: 100%; height: 42px; padding: 0 12px; background: var(--canvas-sunken); border: 1px solid var(--hairline); border-radius: 6px; color: var(--ink); font-size: 14px; font-family: inherit; transition: border-color 0.15s ease;"
            >
              <option value="" disabled selected>Select a category...</option>
              <option value="bug">Bug Report &amp; WebGL Rendering Glitch</option>
              <option value="physics">Physics &amp; Cold-Gas Thruster Tuning</option>
              <option value="feature">Feature Request or Circuit Idea</option>
              <option value="performance">Hardware Benchmark &amp; FPS Diagnostics</option>
              <option value="press">Press, Media &amp; Content Creation</option>
              <option value="general">General Feedback</option>
            </select>
          </div>

          <!-- Platform / Environment -->
          <div>
            <label for="contact-platform" style="display: block; font-size: 13px; font-weight: 600; color: var(--ink); margin-bottom: 0.4rem; font-family: 'Geist Mono', monospace;">
              SYSTEM / BROWSER (OPTIONAL)
            </label>
            <input 
              type="text" 
              id="contact-platform" 
              name="platform" 
              placeholder="e.g. Windows 11 / Chrome 130 / RTX 4070"
              style="width: 100%; height: 42px; padding: 0 12px; background: var(--canvas-sunken); border: 1px solid var(--hairline); border-radius: 6px; color: var(--ink); font-size: 14px; font-family: inherit; transition: border-color 0.15s ease;"
            />
          </div>

          <!-- Message -->
          <div>
            <label for="contact-message" style="display: block; font-size: 13px; font-weight: 600; color: var(--ink); margin-bottom: 0.4rem; font-family: 'Geist Mono', monospace;">
              MESSAGE DETAILS <span style="color: var(--link);">*</span>
            </label>
            <textarea 
              id="contact-message" 
              name="message" 
              rows="5" 
              required 
              placeholder="Please provide details about your observation, suggestion, or reproduction steps..."
              style="width: 100%; padding: 12px; background: var(--canvas-sunken); border: 1px solid var(--hairline); border-radius: 6px; color: var(--ink); font-size: 14px; font-family: inherit; resize: vertical; line-height: 1.5; transition: border-color 0.15s ease;"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <div style="margin-top: 0.5rem;">
            <button 
              type="submit" 
              id="form-submit-btn" 
              class="btn-pill-primary" 
              style="width: 100%; height: 44px; font-size: 14px; justify-content: center;"
            >
              <span id="submit-btn-text">Send Transmission</span>
              <span aria-hidden="true">→</span>
            </button>
          </div>
        </form>

        <!-- Feedback Success Alert (Hidden Initially) -->
        <div id="contact-success" style="display: none; margin-top: 1.5rem; padding: 1.25rem; background: var(--link-soft-bg); border: 1px solid var(--link); border-radius: 6px;">
          <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
            <span style="color: var(--link); font-size: 1.25rem;">✓</span>
            <div>
              <p style="font-weight: 600; color: var(--ink); font-size: 14px;">Transmission Received!</p>
              <p class="body-sm" style="margin-top: 0.25rem; color: var(--body);">
                Thank you for your feedback. Our development team monitors incoming messages and will follow up if diagnostic clarification is required.
              </p>
              <button 
                id="reset-form-btn" 
                class="btn-pill-secondary" 
                style="margin-top: 0.85rem; height: 30px; padding: 0 12px; font-size: 12px;"
              >
                Send Another Transmission
              </button>
            </div>
          </div>
        </div>

      </div>

      <!-- Information & Direct Support Cards -->
      <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        
        <!-- Direct Email Channels -->
        <div class="vercel-card" style="padding: 1.75rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
            <span style="font-size: 1.25rem;">✉️</span>
            <span class="mono-eyebrow" style="color: var(--ink);">DIRECT EMAIL CHANNELS</span>
          </div>
          <div style="display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem;">
            <div>
              <span style="font-size: 12px; color: var(--mute); display: block; font-family: 'Geist Mono', monospace;">GENERAL &amp; BUG SUPPORT</span>
              <a href="mailto:support@roadster-play.vercel.app" class="nav-link" style="padding: 0; color: var(--link); font-weight: 600; font-size: 15px;">
                support@roadster-play.vercel.app
              </a>
            </div>
            <div>
              <span style="font-size: 12px; color: var(--mute); display: block; font-family: 'Geist Mono', monospace;">PRESS &amp; PARTNERSHIPS</span>
              <a href="mailto:press@roadster-play.vercel.app" class="nav-link" style="padding: 0; color: var(--link); font-weight: 600; font-size: 15px;">
                press@roadster-play.vercel.app
              </a>
            </div>
          </div>
        </div>

        <!-- WebGL Bug Reporting Checklist -->
        <div class="vercel-card" style="padding: 1.75rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
            <span style="font-size: 1.25rem;">🛠️</span>
            <span class="mono-eyebrow" style="color: var(--ink);">REPORTING A WEBGL BUG?</span>
          </div>
          <p class="body-sm" style="color: var(--body); line-height: 1.6;">
            To help our graphics engineers isolate rendering or shader artifacts quickly, please consider including:
          </p>
          <ul style="margin-top: 0.75rem; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.4rem; font-size: 13px; color: var(--mute);">
            <li>Your GPU model (NVIDIA, AMD, Apple Silicon, Intel)</li>
            <li>Browser &amp; version (e.g. Chrome 130, Safari 18)</li>
            <li>Operating System (Windows 11, macOS Sequoia, iOS, Android)</li>
            <li>Any red errors logged in the browser Developer Tools Console (<kbd>F12</kbd>)</li>
          </ul>
        </div>

        <!-- Community & Social -->
        <div class="vercel-card" style="padding: 1.75rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
            <span style="font-size: 1.25rem;">⚡</span>
            <span class="mono-eyebrow" style="color: var(--ink);">RESPONSE TIMELINE</span>
          </div>
          <p class="body-sm" style="color: var(--body); line-height: 1.6;">
            Our open-source team typically reviews diagnostic transmissions within <strong>24 to 48 business hours</strong>. Critical shader compile crashes and rendering bugs are prioritized immediately for rapid deployment to our edge CDN.
          </p>
        </div>

      </div>

    </div>

    <!-- Troubleshooting Mini-FAQ Section -->
    <section style="margin-top: 5rem; border-top: 1px solid var(--hairline); padding-top: 3.5rem;">
      <div style="margin-bottom: 2.5rem; text-align: center;">
        <span class="mono-eyebrow" style="color: var(--link);">INSTANT ASSISTANCE</span>
        <h2 class="heading-lg" style="margin-top: 0.35rem; color: var(--ink);">Quick Troubleshooting Guide</h2>
        <p class="body-md" style="margin-top: 0.5rem; color: var(--mute); max-width: 600px; margin-left: auto; margin-right: auto;">
          Common questions regarding simulator controls, frame rates, and hardware requirements.
        </p>
      </div>

      <div class="faq-accordion">
        <details class="faq-item">
          <summary class="faq-trigger">
            <span>Why is my simulator rendering at low FPS or lagging?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-content">
            Ensure that <strong>Hardware Acceleration</strong> is enabled in your browser settings (Chrome: Settings &gt; System &gt; Use graphics acceleration when available). If you have both an integrated GPU and a dedicated graphics card (such as an NVIDIA or AMD GPU), ensure your operating system assigns high performance to your browser.
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-trigger">
            <span>My vehicle flipped over after a jump. How do I recover?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-content">
            Press the <span class="kbd-pill">U</span> key at any time to activate the automated gyroscopic upright stabilization routine. This instantly levels the chassis horizontally and restores normal ground wheel contact.
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-trigger">
            <span>How do I play on an iPhone, iPad, or Android phone?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-content">
            Simply visit <a href="/play" class="nav-link" style="padding: 0; color: var(--link); text-decoration: underline;">/play</a> on any modern mobile browser. The simulator automatically detects touch displays and renders an ergonomic virtual steering wheel, throttle, brake, and SpaceX rocket boost buttons directly on your screen.
          </div>
        </details>
      </div>
    </section>

  </div>

  <script>
    const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
    const successBox = document.getElementById('contact-success');
    const submitBtn = document.getElementById('form-submit-btn') as HTMLButtonElement | null;
    const submitBtnText = document.getElementById('submit-btn-text');
    const resetBtn = document.getElementById('reset-form-btn');

    if (contactForm && successBox && submitBtn && submitBtnText) {
      contactForm.addEventListener('submit', (e) => {
        e.preventDefault();

        // Simulate transmission state
        submitBtn.disabled = true;
        submitBtnText.textContent = 'Transmitting...';

        setTimeout(() => {
          contactForm.style.display = 'none';
          successBox.style.display = 'block';
          submitBtn.disabled = false;
          submitBtnText.textContent = 'Send Transmission';
        }, 600);
      });
    }

    if (resetBtn && contactForm && successBox) {
      resetBtn.addEventListener('click', () => {
        contactForm.reset();
        contactForm.style.display = 'flex';
        successBox.style.display = 'none';
      });
    }
  </script>
</Layout>
