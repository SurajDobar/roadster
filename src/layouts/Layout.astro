---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  keywords?: string;
  ogImage?: string;
  robots?: string;
}

const {
  title,
  description,
  canonical = 'https://roadster-play.vercel.app/',
  keywords = '3D Tesla Roadster Game, Tesla Roadster game, Roadster game, Tesla Roadster driving game, Tesla Roadster open world game, play Tesla Roadster online, webgl car game, hypercar simulator',
  ogImage = 'https://roadster-play.vercel.app/og-image.png',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-L9VFLEVQ68" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-L9VFLEVQ68');
  </script>

  <meta name="google-site-verification" content="Pq1K2d7jnfoiB4Yo97FwFed6FULnOyvp3zvXRwydwFM" />

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta name="theme-color" content="#fafafa" id="meta-theme-color" />
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="robots" content={robots} />
  <meta name="author" content="Tesla Roadster 3D Game" />
  <link rel="canonical" href={canonical} />
  <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Context" />

  <!-- Favicon & Web App Manifest -->
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="apple-mobile-web-app-title" content="Roadster" />

  <!-- Open Graph / Facebook / Discord -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="3D Tesla Roadster Game" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:secure_url" content={ogImage} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="3D Tesla Roadster Game - Play Tesla Roadster Driving Game Online" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter / X Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonical} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content="3D Tesla Roadster Game - Play Online" />

  <!-- Structured Data: WebSite Schema -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "3D Tesla Roadster Game",
    "alternateName": ["Tesla Roadster Game", "Roadster Game", "Tesla Roadster Driving Game", "Tesla Roadster Open World Game"],
    "url": "https://roadster-play.vercel.app/",
    "description": "Play the free 3D Tesla Roadster game online. High-speed Tesla Roadster driving game featuring SpaceX cold-gas thrusters, open world sandbox, drag strip racing, and alpine mountain circuit."
  }
  </script>

  <!-- Fonts: Geist, Geist Mono, Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style is:global>
    :root {
      /* Vercel Geist Light Studio Tokens */
      --primary: #171717;
      --on-primary: #ffffff;
      --ink: #171717;
      --body: #444444;
      --mute: #666666;
      --faint: #8e8e8e;
      --hairline: #e5e5e5;
      --hairline-soft: #f0f0f0;
      --canvas: #fafafa;
      --canvas-elevated: #ffffff;
      --canvas-sunken: #f5f5f5;
      --nav-bg: rgba(250, 250, 250, 0.82);
      --link: #0070f3;
      --link-deep: #0761d1;
      --link-soft: #d3e5ff;
      --link-soft-bg: rgba(0, 112, 243, 0.08);
      --error: #ee0000;
      --error-deep: #c50000;
      --warning: #f5a623;
      --success: #0070f3;
      --violet: #7928ca;
      --cyan: #00dfd8;
      --pink: #ff0080;
      --accent-badge: #000000;
      --accent-badge-text: #ffffff;

      /* Mesh Hero Gradients */
      --grad-develop-start: #007cf0;
      --grad-develop-end: #00dfd8;
      --grad-preview-start: #7928ca;
      --grad-preview-end: #ff0080;
      --grad-ship-start: #ff4d4d;
      --grad-ship-end: #f9cb28;
    }

    /* Vercel Geist Dark Studio Tokens */
    html[data-theme="dark"] {
      --primary: #ffffff;
      --on-primary: #000000;
      --ink: #ededed;
      --body: #a1a1a1;
      --mute: #737373;
      --faint: #525252;
      --hairline: #262626;
      --hairline-soft: #1c1c1c;
      --canvas: #000000;
      --canvas-elevated: #0a0a0a;
      --canvas-sunken: #111111;
      --nav-bg: rgba(0, 0, 0, 0.82);
      --link: #3291ff;
      --link-deep: #0070f3;
      --link-soft: rgba(0, 112, 243, 0.18);
      --link-soft-bg: rgba(50, 145, 255, 0.12);
      --error: #ff4d4d;
      --accent-badge: #ffffff;
      --accent-badge-text: #000000;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: var(--canvas);
      color: var(--ink);
      font-family: Geist, Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      transition: background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Vercel Typography Scale */
    .display-xl {
      font-size: clamp(2.5rem, 6vw, 3.75rem);
      font-weight: 700;
      line-height: 1.05;
      letter-spacing: -0.045em;
      text-wrap: balance;
    }

    .heading-lg {
      font-size: clamp(1.75rem, 4vw, 2.25rem);
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: -0.035em;
      text-wrap: balance;
    }

    .heading-md {
      font-size: 1.25rem;
      font-weight: 600;
      line-height: 1.4;
      letter-spacing: -0.02em;
    }

    .mono-eyebrow {
      font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 11px;
      font-weight: 600;
      line-height: 16px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .body-lg {
      font-size: 16px;
      font-weight: 400;
      line-height: 26px;
      letter-spacing: -0.01em;
      color: var(--body);
    }

    .body-md {
      font-size: 14px;
      font-weight: 400;
      line-height: 22px;
      letter-spacing: -0.005em;
      color: var(--body);
    }

    .body-sm {
      font-size: 12px;
      font-weight: 400;
      line-height: 18px;
      letter-spacing: 0;
      color: var(--mute);
    }

    /* Pill Buttons (100px rounded) */
    .btn-pill-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      height: 40px;
      padding: 0 18px;
      background: var(--ink);
      color: var(--on-primary);
      border-radius: 100px;
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      border: 1px solid var(--ink);
      transition: transform 0.15s ease, opacity 0.15s ease, box-shadow 0.15s ease;
      cursor: pointer;
    }
    .btn-pill-primary:hover {
      opacity: 0.92;
      transform: translateY(-1px);
    }
    .btn-pill-primary:active {
      transform: translateY(0);
    }

    .btn-pill-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      height: 40px;
      padding: 0 18px;
      background: var(--canvas-elevated);
      color: var(--ink);
      border-radius: 100px;
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      border: 1px solid var(--hairline);
      transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
      cursor: pointer;
    }
    .btn-pill-secondary:hover {
      border-color: var(--ink);
      transform: translateY(-1px);
    }

    /* Vercel Square Nav Buttons (6px rounded) */
    .btn-nav-square {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 32px;
      padding: 0 14px;
      border-radius: 6px;
      background: var(--ink);
      color: var(--on-primary);
      font-size: 13px;
      font-weight: 500;
      text-decoration: none;
      border: 1px solid var(--ink);
      transition: opacity 0.15s ease, transform 0.15s ease;
      cursor: pointer;
    }
    .btn-nav-square:hover {
      opacity: 0.9;
      transform: translateY(-0.5px);
    }

    .btn-theme-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 6px;
      background: var(--canvas-elevated);
      color: var(--ink);
      border: 1px solid var(--hairline);
      cursor: pointer;
      font-size: 14px;
      transition: border-color 0.15s ease, background 0.15s ease;
    }
    .btn-theme-toggle:hover {
      border-color: var(--ink);
    }

    /* Vercel Clean Card Container */
    .vercel-card {
      background: var(--canvas-elevated);
      border: 1px solid var(--hairline);
      border-radius: 8px;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
    }
    .vercel-card:hover {
      border-color: var(--ink);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
      transform: translateY(-2px);
    }

    .nav-link {
      color: var(--body);
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      transition: color 0.15s ease;
      padding: 4px 6px;
    }
    .nav-link:hover {
      color: var(--ink);
    }
    .nav-link.active {
      color: var(--ink);
      font-weight: 600;
    }

    .mobile-drawer {
      display: none;
      border-top: 1px solid var(--hairline);
      background: var(--canvas-elevated);
      transition: all 0.2s ease;
    }
    .mobile-drawer.open {
      display: block !important;
    }

    @media (max-width: 960px) {
      .desktop-nav {
        display: none !important;
      }
      .mobile-nav-controls {
        display: flex !important;
      }
    }

    /* Tri-Color Mesh Hero Gradient */
    .hero-mesh-text {
      background: linear-gradient(135deg, var(--grad-develop-start) 0%, var(--grad-preview-start) 50%, var(--grad-ship-start) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Interactive Comparison Matrix Table */
    .specs-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      font-size: 14px;
    }
    .specs-table th, .specs-table td {
      padding: 14px 18px;
      text-align: left;
      border-bottom: 1px solid var(--hairline);
    }
    .specs-table th {
      font-family: "Geist Mono", monospace;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--mute);
      background: var(--canvas);
    }
    .specs-table tr:hover td {
      background: var(--canvas-sunken);
    }
    .specs-table td.highlight {
      font-weight: 600;
      color: var(--link);
    }

    /* Control key pills */
    .kbd-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 28px;
      height: 24px;
      padding: 0 6px;
      background: var(--canvas-sunken);
      border: 1px solid var(--hairline);
      border-bottom-width: 2px;
      border-radius: 4px;
      font-family: "Geist Mono", monospace;
      font-size: 11px;
      font-weight: 600;
      color: var(--ink);
    }

    /* FAQ Accordion Styling (Strict Vercel Geist System) */
    .faq-accordion {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      max-width: 900px;
      margin: 0 auto;
      text-align: left;
    }
    .faq-item {
      background: var(--canvas-elevated);
      border: 1px solid var(--hairline);
      border-radius: 8px;
      overflow: hidden;
      transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    }
    .faq-item:hover {
      border-color: var(--ink);
    }
    .faq-item[open] {
      border-color: var(--link);
      box-shadow: 0 4px 16px rgba(0, 112, 243, 0.06);
    }
    .faq-trigger {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.2rem 1.5rem;
      font-size: 15.5px;
      font-weight: 600;
      color: var(--ink);
      cursor: pointer;
      list-style: none;
      user-select: none;
      gap: 1rem;
      transition: color 0.15s ease;
    }
    .faq-trigger::-webkit-details-marker {
      display: none;
    }
    .faq-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--canvas-sunken);
      border: 1px solid var(--hairline);
      font-family: monospace;
      font-size: 15px;
      line-height: 1;
      color: var(--mute);
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.15s ease, color 0.15s ease;
      flex-shrink: 0;
    }
    .faq-item[open] .faq-icon {
      transform: rotate(45deg);
      background: var(--link-soft-bg);
      color: var(--link);
      border-color: var(--link);
    }
    .faq-content {
      padding: 0 1.5rem 1.35rem;
      color: var(--body);
      font-size: 14.5px;
      line-height: 1.65;
      border-top: 1px solid var(--hairline-soft);
      padding-top: 1rem;
    }

    @media (prefers-reduced-motion: reduce) {
      * {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>

  <script is:inline>
    // Immediate Theme Initialization to avoid Flash of Unstyled Content
    (function() {
      const savedTheme = localStorage.getItem('roadster-theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
      const meta = document.getElementById('meta-theme-color');
      if (meta) meta.setAttribute('content', savedTheme === 'dark' ? '#000000' : '#fafafa');
    })();
  </script>
</head>
<body>
  <!-- Vercel Nav Chrome Header -->
  <header style="border-bottom: 1px solid var(--hairline); position: sticky; top: 0; z-index: 50; background: var(--nav-bg); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);">
    <div style="max-width: 1180px; margin: 0 auto; padding: 0.75rem 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem;">
      <a href="/" style="display: flex; align-items: center; gap: 0.625rem; text-decoration: none; color: var(--ink); flex-shrink: 0;" aria-label="Tesla Roadster 2026 Home">
        <!-- Vercel Triangle Glyph -->
        <svg width="18" height="18" viewBox="0 0 76 65" fill="currentColor">
          <path d="M37.5274 0L75.0548 65H0L37.5274 0Z" />
        </svg>
        <span style="font-weight: 600; letter-spacing: -0.4px; font-size: 15px;">ROADSTER <span style="color: var(--link);" translate="no">2026</span></span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="desktop-nav" style="display: flex; align-items: center; gap: 1.25rem;" aria-label="Primary navigation">
        <a href="/" class={`nav-link ${currentPath === '/' ? 'active' : ''}`}>Overview</a>
        <a href="/#modes" class="nav-link">Modes</a>
        <a href="/#features" class="nav-link">Features</a>
        <a href="/about" class={`nav-link ${currentPath === '/about' ? 'active' : ''}`}>About</a>
        <a href="/contact" class={`nav-link ${currentPath === '/contact' ? 'active' : ''}`}>Contact</a>
        
        <!-- Light / Dark Mode Toggle Button with crisp icon -->
        <button id="theme-toggle-btn" class="btn-theme-toggle" title="Toggle Light/Dark Theme" aria-label="Toggle Theme">
          <span id="theme-icon">☀</span>
        </button>

        <a href="/play" class="btn-nav-square">Play Simulator</a>
      </nav>

      <!-- Mobile Navigation Controls -->
      <div class="mobile-nav-controls" style="display: none; align-items: center; gap: 0.5rem;">
        <button id="mobile-theme-toggle-btn" class="btn-theme-toggle" title="Toggle Light/Dark Theme" aria-label="Toggle Theme">
          <span id="mobile-theme-icon">☀</span>
        </button>
        <button id="mobile-menu-toggle" class="btn-theme-toggle" title="Toggle Navigation Menu" aria-label="Toggle Navigation Menu" aria-expanded="false">
          <span id="mobile-menu-icon" style="font-size: 16px; line-height: 1;">☰</span>
        </button>
      </div>
    </div>

    <!-- Mobile Drawer Menu -->
    <div id="mobile-drawer" class="mobile-drawer">
      <div style="display: flex; flex-direction: column; gap: 0.6rem; padding: 1rem 1.5rem 1.5rem;">
        <a href="/" class={`nav-link ${currentPath === '/' ? 'active' : ''}`} style="padding: 0.35rem 0;">Overview</a>
        <a href="/#modes" class="nav-link" style="padding: 0.35rem 0;">Simulation Modes</a>
        <a href="/#features" class="nav-link" style="padding: 0.35rem 0;">Features &amp; Physics</a>
        <a href="/about" class={`nav-link ${currentPath === '/about' ? 'active' : ''}`} style="padding: 0.35rem 0;">About Us</a>
        <a href="/contact" class={`nav-link ${currentPath === '/contact' ? 'active' : ''}`} style="padding: 0.35rem 0;">Contact Us</a>
        <a href="/privacy" class={`nav-link ${currentPath === '/privacy' ? 'active' : ''}`} style="padding: 0.35rem 0;">Privacy Policy</a>
        <a href="/terms" class={`nav-link ${currentPath === '/terms' ? 'active' : ''}`} style="padding: 0.35rem 0;">Terms &amp; Conditions</a>
        <div style="padding-top: 0.75rem; border-top: 1px solid var(--hairline-soft); margin-top: 0.35rem;">
          <a href="/play" class="btn-pill-primary" style="width: 100%; text-align: center; justify-content: center; height: 38px;">Play Simulator Now →</a>
        </div>
      </div>
    </div>
  </header>

  <main style="flex: 1;" id="main-content">
    <slot />
  </main>

  <!-- Vercel Clean Footer -->
  <footer style="border-top: 1px solid var(--hairline); padding: 3.5rem 1.5rem 2.5rem; background: var(--canvas-elevated); font-size: 13px; color: var(--mute);">
    <div style="max-width: 1180px; margin: 0 auto; display: flex; flex-direction: column; gap: 2.5rem;">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2.5rem; align-items: flex-start;">
        
        <!-- Column 1: Brand & Simulation Summary -->
        <div style="max-width: 320px;">
          <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--ink); font-weight: 600; font-size: 15px;">
            <svg width="16" height="16" viewBox="0 0 76 65" fill="currentColor">
              <path d="M37.5274 0L75.0548 65H0L37.5274 0Z" />
            </svg>
            <span>3D Tesla Roadster Game</span>
          </div>
          <p class="body-sm" style="margin-top: 0.75rem; line-height: 1.6;">
            Next-generation 3D Tesla Roadster game and WebGL driving simulator. Featuring Three.js physics, SpaceX cold-gas thruster plumes, 2G wall suction, open world sandbox exploration, and 1/4 mile drag racing.
          </p>
          <div style="margin-top: 1.25rem;">
            <a href="/play" class="btn-pill-primary" style="height: 32px; padding: 0 14px; font-size: 12px;">Launch Game Viewport →</a>
          </div>
        </div>

        <!-- Column 2: Simulation & Track Links -->
        <div>
          <span class="mono-eyebrow" style="color: var(--ink); display: block; margin-bottom: 0.75rem;">Simulation</span>
          <nav style="display: flex; flex-direction: column; gap: 0.5rem;" aria-label="Footer simulation links">
            <a href="/" class="nav-link" style="padding: 0;">Overview &amp; Showcase</a>
            <a href="/#features" class="nav-link" style="padding: 0;">SpaceX Thruster Package</a>
            <a href="/#modes" class="nav-link" style="padding: 0;">Open World Free Roam</a>
            <a href="/#comparison" class="nav-link" style="padding: 0;">Hypercar Benchmark Matrix</a>
            <a href="/#controls" class="nav-link" style="padding: 0;">Telemetry &amp; Controls</a>
            <a href="/#faq" class="nav-link" style="padding: 0;">FAQ</a>
          </nav>
        </div>

        <!-- Column 3: Information & Pages (MPA Routes) -->
        <div>
          <span class="mono-eyebrow" style="color: var(--ink); display: block; margin-bottom: 0.75rem;">Company &amp; Team</span>
          <nav style="display: flex; flex-direction: column; gap: 0.5rem;" aria-label="Footer information links">
            <a href="/about" class={`nav-link ${currentPath === '/about' ? 'active' : ''}`} style="padding: 0; font-weight: 500;">About Us</a>
            <a href="/contact" class={`nav-link ${currentPath === '/contact' ? 'active' : ''}`} style="padding: 0; font-weight: 500;">Contact Us</a>
